# Copy to .streamlit/secrets.toml (gitignored) and fill in. Streamlit reads this
# file for st.login(). Any OpenID Connect provider works: Microsoft Entra ID,
# Okta, Google Workspace, Auth0, Keycloak.
#
# Register this redirect URI with the provider:
#   <app base URL>/oauth2callback

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Random string used to sign the session cookie, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
client_id = ""
client_secret = ""
# Examples:
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#   Okta:     https://<your-org>.okta.com/.well-known/openid-configuration
server_metadata_url = ""
