# Copy to .env and fill in. Leave both keys empty to run in search-only mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: "openai" or "anthropic". Empty means auto-detect (Anthropic first if both keys are set).
LLM_PROVIDER=

# Optional model override. Defaults: claude-sonnet-4-20250514 (Anthropic), gpt-4 (OpenAI).
LLM_MODEL=

# Optional: defaults to a local SQLite file, sqlite:///./auditflow.db
# DATABASE_URL=
